        </calculation>
      </column>
      <column caption='Distance Tier' datatype='string' name='[Calculation_0369206809456640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [distance_km] &lt; 3 THEN &quot;Short (&lt;3km)&quot;&#13;&#10;ELSEIF [distance_km] &lt;= 10 THEN &quot;Medium (3-10km)&quot;&#13;&#10;ELSE &quot;Long (&gt;10km)&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Completed Revenue' datatype='real' name='[Calculation_0369206809931777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;Completed&quot; THEN [fare_amount] END)' />
      </column>
      <column caption='Completed Trip Count' datatype='integer' name='[Calculation_0369206810189826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &quot;Completed&quot; THEN [trip_id] END)' />
      </column>
      <column caption='Yield Per KM ($/KM)' datatype='real' name='[Calculation_0369206810411011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0369206809931777] / SUM(IF [status] = &quot;Completed&quot; THEN [distance_km] END)' />
      </column>
      <column caption='Cancellation Rate %' datatype='real' name='[Calculation_0369206810660868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &quot;Cancelled&quot; THEN [trip_id] END) / COUNTD([trip_id])' />
      </column>
      <column caption='Ride Duration (Minutes)' datatype='integer' name='[Calculation_0369206810984453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [pickup_time], [drop_time])' />
      </column>
      <column caption='No-Show Rate %' datatype='real' name='[Calculation_1579219611402240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &apos;No-Show&apos; THEN [trip_id] END) / COUNT([trip_id])' />
      </column>
      <column caption='Pickup Hour' datatype='integer' name='[Calculation_1579219611897857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [pickup_time])' />
      </column>
      <column caption='Avg Ride Duration' datatype='real' name='[Calculation_1579219612065794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [status] = &apos;Completed&apos; THEN [Calculation_0369206810984453] END)' />
      </column>
      <column caption='Total Requests' datatype='integer' name='[Calculation_1579219612524547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([trip_id])' />
      </column>
      <column caption='Total Payment Share %' datatype='real' name='[Calculation_1579219636707332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([trip_id]) / SUM({ FIXED : COUNTD([trip_id]) })' />
      </column>
      <column caption='Avg Fare by Payment Method' datatype='real' name='[Calculation_1579219636998149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [status] = &apos;Completed&apos; THEN [fare_amount] END)' />
      </column>
      <column caption='Fare Quartile Rank' datatype='string' name='[Calculation_1579219646652426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fare_amount] &lt;= { FIXED : PERCENTILE([fare_amount], 0.25) } THEN &quot;Q1 (Lowest)&quot;&#13;&#10;ELSEIF [fare_amount] &lt;= { FIXED : PERCENTILE([fare_amount], 0.50) } THEN &quot;Q2&quot;&#13;&#10;ELSEIF [fare_amount] &lt;= { FIXED : PERCENTILE([fare_amount], 0.75) } THEN &quot;Q3&quot;&#13;&#10;ELSE &quot;Q4 (Highest)&quot;&#13;&#10;END' />
      </column>
