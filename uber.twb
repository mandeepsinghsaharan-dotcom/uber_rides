            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='67842' id='6' story-point-id='1' type-v2='text' w='99902' x='0' y='11929'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'>Spatial Telemetry &amp; Regional Distribution</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'>GPS coordinate telemetry reveals dense, uniform cluster distribution within each city&apos;s latitude/longitude boundaries (</run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Google Sans Text,sans-serif'>spanning latitudes 37.0°N to 41.0°N and longitudes -122.0°W to -73.0°W)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'>Fare Quartile Breakdown (NTILE)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'>Partitioning trips into </run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Google Sans Text,sans-serif'>four equal volume quartiles</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans Text,sans-serif'> confirms balanced fare distribution across every market:</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'>Q1 (Lowest Fares):</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'> Fares $\le$ $9.15 (1,745 – 1,819 trips/city)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'>Q2 (Mid-Low Fares):</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'> Fares $9.16 – $15.95 (1,704 – 1,844 trips/city)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'>Q3 (Mid-High Fares):</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'> Fares $15.96 – $22.75 (1,714 – 1,809 trips/city)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'>Q4 (Highest Fares):</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Google Sans Text,sans-serif' fontsize='10'> Fares &gt; $22.75 (1,639 – 1,839 trips/city)</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{7F3D9C16-B871-4F24-AE2D-7950D0E78EDE}' />
