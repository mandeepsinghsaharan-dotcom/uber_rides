  <dashboards>
    <dashboard name='1' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='387' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' preset-index='9' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='830' />
            <zone h='87863' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='11307'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Executive Revenue &amp; Business Overview' captured-sheet='' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='89627' id='6' story-point-id='1' type-v2='text' w='100000' x='0' y='11203'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>The platform generated</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>Æ </run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>$679,685</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> in total completed fare revenue across</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>Æ </run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>42,540 completed rides</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, averaging an operational yield of </run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>$2.28 per kilometer</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>. Revenue distribution across the six target cities remains tightly balanced, demonstrating strong brand penetration in all core markets:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>Boston:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $115,028</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>San Francisco:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $114,661</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>Seattle:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $113,343</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>New York:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $113,175</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>Chicago:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $112,791</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'>Los Angeles:</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Benton Sans Book' fontsize='10'> $110,687</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Monetization Decay Across Distance Tiers</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>A key pricing insight emerges when evaluating yield relative to trip distance:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>Distance-Tier Distance Yield/KM  Pricing Dynamic</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'><![CDATA[Short         <3km      $3.50/km High base-fare density & surge efficiency]]></run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>Medium        3–10km    $2.30/km Standard operational pricing efficiency</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>Long          &gt;10km     $2.11/km Margin dilution over extended mileage</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Strategic Insight:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Short-distance trips yield </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Bodoni MT'>65.8% more revenue per kilometer</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> than long-distance rides. Increasing short-haul urban driver density will maximize per-kilometer yield.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{8B39248D-1C36-4BD8-8C34-9215A64896BD}' />
    </dashboard>
    <dashboard name='2' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='409' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' preset-index='9' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='830' />
            <zone h='87863' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='11307'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Operational Efficiency &amp; Demand Dynamics' captured-sheet='' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='70539' id='6' story-point-id='1' type-v2='text' w='100492' x='-591' y='12656'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>24-Hour Demand Curve</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Trip request volume remains consistently high from </run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'>00:00 through 16:00</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Bodoni MT'> (~2,100 requests/hour platform-wide)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, followed by a sharp drop-off between </run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'>17:00 and 23:00</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'> (~2,040 requests/hour)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>Time Window        Avg Request Volume/Hr        Platform Behavior</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>00:00 – 16:00      ~2,100 requests              Peak demand &amp; optimal driver utilization</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>17:00 – 18:00      ~2,060 requests              Transition phase</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#f9a655' fontname='Courier New' fontsize='10'>19:00 – 23:00      ~2,040 requests              Evening demand moderation</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Friction &amp; Loss Rates</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Platform friction metrics remain uniform across all six metropolitan regions:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'>Completion Rate:</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'> ~85.1%</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'>Cancellation Rate:</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'> ~10.0% (ranging from 9.7% in Seattle to 10.3% in Boston)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'>No-Show Rate:</run>
            <run fontalignment='0' fontcolor='#f28e2b' fontname='Benton Sans Book'> ~4.9%</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Operational Bottleneck:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Trip duration scales linearly with distance, averaging </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>6.3 minutes</run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'> for short trips</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>,</run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>Æ </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>20.1 minutes</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>for medium trips</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, and</run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>Æ </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>34.8 minutes</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
            <run fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>for long trips</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>. Extreme outliers on long trips reach up to </run>
            <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Benton Sans Book'>56 minutes</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>, indicating localized urban congestion bottlenecks.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{40F2AA48-B56B-4C38-BC80-A775AAF5B19B}' />
    </dashboard>
