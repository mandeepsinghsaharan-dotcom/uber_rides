    <worksheet name='Yield per KM by Distance Tier'>
      <table>
        <view>
          <datasources>
            <datasource caption='uber_cleaned_data' name='federated.03cc955067l2zi13nwjve1rwb7gd' />
          </datasources>
          <datasource-dependencies datasource='federated.03cc955067l2zi13nwjve1rwb7gd'>
            <column caption='Distance Tier' datatype='string' name='[Calculation_0369206809456640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [distance_km] &lt; 3 THEN &quot;Short (&lt;3km)&quot;&#13;&#10;ELSEIF [distance_km] &lt;= 10 THEN &quot;Medium (3-10km)&quot;&#13;&#10;ELSE &quot;Long (&gt;10km)&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Completed Revenue' datatype='real' name='[Calculation_0369206809931777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [status] = &quot;Completed&quot; THEN [fare_amount] END)' />
            </column>
            <column caption='Yield Per KM ($/KM)' datatype='real' name='[Calculation_0369206810411011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0369206809931777] / SUM(IF [status] = &quot;Completed&quot; THEN [distance_km] END)' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Distance Km' datatype='real' name='[distance_km]' role='measure' type='quantitative' />
            <column caption='Fare Amount' datatype='real' name='[fare_amount]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0369206809456640]' derivation='None' name='[none:Calculation_0369206809456640:nk]' pivot='key' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0369206810411011]' derivation='User' name='[usr:Calculation_0369206810411011:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.03cc955067l2zi13nwjve1rwb7gd].[Action (City)]'>
            <groupfilter function='union' user:ui-action-filter='[Action1_4DEE4D048DE741DE8F128649A8EAE46C]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[city]' member='&quot;Boston&quot;' />
              <groupfilter function='member' level='[city]' member='&quot;Chicago&quot;' />
              <groupfilter function='member' level='[city]' member='&quot;Los Angeles&quot;' />
              <groupfilter function='member' level='[city]' member='&quot;New York&quot;' />
              <groupfilter function='member' level='[city]' member='&quot;San Francisco&quot;' />
              <groupfilter function='member' level='[city]' member='&quot;Seattle&quot;' />
            </groupfilter>
          </filter>
          <natural-sort column='[federated.03cc955067l2zi13nwjve1rwb7gd].[none:Calculation_0369206809456640:nk]' direction='DESC' />
          <slices>
            <column>[federated.03cc955067l2zi13nwjve1rwb7gd].[Action (City)]</column>
          </slices>
          <aggregation value='true' />
        </view>
